# MongoDB (same database as the server)
MONGODB_URI=mongodb+srv://salonbook:salonbook123@cluster0.mept83i.mongodb.net/
MONGODB_DB=salonbook

# Better Auth
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
